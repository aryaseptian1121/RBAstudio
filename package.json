{
  "name": "rba-studio-pro",
  "version": "1.0.0",
  "description": "RBA Studio Pro — Workflow Automation",
  "main": "main.js",
  "author": "Arya Septian",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "jimp": "^0.22.10",
    "tesseract.js": "^2.1.5"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.rba.studio.pro",
    "productName": "RBA Studio Pro",
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "extraResources": [
      {
        "from": "scrcpy/",
        "to": "scrcpy/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/bcryptjs/**",
      "node_modules/jimp/**"
    ]
  }
}
