{
  "name": "rba-studio-pro",
  "version": "1.0.0",
  "description": "RBA Studio Pro — Workflow Automation",
  "main": "main.js",
  "author": "Arya Septian",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "chrome-remote-interface": "^0.34.0",
    "clipboardy": "^5.3.1",
    "jimp": "^0.22.10",
    "node-window-manager": "^2.2.4",
    "robotjs": "^0.7.1",
    "tesseract.js": "^2.1.5",
    "uiohook-napi": "^1.5.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.rba.studio.pro",
    "productName": "RBA Studio Pro",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "win": {
      "target": "nsis",
      "icon": "RBA_logo.png",
      "requestedExecutionLevel": "asInvoker",
      "certificateFile": null,
      "certificatePassword": null,
      "signingHashAlgorithms": [
        "sha256"
      ]
    },
    "extraResources": [
      {
        "from": "scrcpy/",
        "to": "scrcpy/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/bcryptjs/**",
      "node_modules/jimp/**",
      "node_modules/robotjs/**",
      "node_modules/node-window-manager/**"
    ]
  }
}
