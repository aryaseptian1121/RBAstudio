{
  "name": "rba-studio-pro",
  "version": "1.0.0",
  "description": "RBA Studio Pro — Workflow Automation",
  "main": "main.js",
  "author": "Arya Septian",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "npm run prebuild-app && electron-builder --win --x64",
    "rebuild": "electron-rebuild -f -w robotjs,uiohook-napi",
    "prebuild-app": "npm run rebuild",
    "predist": "npm run rebuild"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "chrome-remote-interface": "^0.34.0",
    "clipboardy": "^5.3.1",
    "fast-xml-parser": "^4.5.6",
    "jimp": "^0.22.10",
    "node-window-manager": "^2.2.4",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "robotjs": "^0.7.1",
    "tesseract.js": "^2.1.5",
    "uiohook-napi": "^1.5.5",
    "whatsapp-web.js": "^1.34.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.rba.studio.pro",
    "productName": "RBA Studio Pro",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "win": {
      "target": "nsis",
      "icon": "RBA_logo.png",
      "requestedExecutionLevel": "asInvoker",
      "certificateFile": null,
      "certificatePassword": null,
      "signingHashAlgorithms": [
        "sha256"
      ]
    },
    "extraResources": [
      {
        "from": "scrcpy/",
        "to": "scrcpy/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "puppeteer-cache/",
        "to": "puppeteer-cache/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/bcryptjs/**",
      "node_modules/jimp/**",
      "node_modules/robotjs/**",
      "node_modules/uiohook-napi/**",
      "node_modules/node-window-manager/**",
      "node_modules/whatsapp-web.js/**",
      "node_modules/qrcode/**",
      "node_modules/tesseract.js/**"
    ]
  }
}
